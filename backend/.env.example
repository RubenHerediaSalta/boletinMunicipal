# ==============================================
# CONFIGURACIÓN DE ENTORNO - BOLETÍN MUNICIPAL
# ==============================================

# Entorno de ejecución
NODE_ENV=development

# Puerto del servidor
PORT=5000

# ==============================================
# BASE DE DATOS POSTGRESQL
# ==============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=boletin_municipal
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# ==============================================
# AUTENTICACIÓN JWT
# ==============================================
# IMPORTANTE: Generar un secret seguro para producción
# Puedes usar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiar_por_secret_seguro_en_produccion
JWT_EXPIRES_IN=7d

# ==============================================
# CORS - Orígenes permitidos
# ==============================================
# En desarrollo: http://localhost:3000,http://localhost:3001
# En producción: https://admin.tudominio.com,https://www.tudominio.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ==============================================
# RAILWAY (Producción)
# ==============================================
# Railway provee automáticamente:
# - DATABASE_URL (conexión completa a PostgreSQL)
# - PORT (puerto asignado)
# 
# Para Railway, solo necesitas configurar:
# - JWT_SECRET
# - JWT_EXPIRES_IN
# - ALLOWED_ORIGINS (tus dominios de Vercel)
